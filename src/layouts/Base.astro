---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Recepten van Dave, snel bij de hand in de supermarkt." />
    <meta name="theme-color" content="#2f7d4f" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Recepten" />
  </head>
  <body>
    <slot />
    <div class="update" id="update" role="status" hidden>
      <span>Nieuwe versie beschikbaar</span>
      <button type="button" id="update-reload">Verversen</button>
    </div>
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          // De eerste controller is de eerste installatie: niets nieuws te melden. Elke wissel daarna is
          // een nieuwe versie.
          let hadController = Boolean(navigator.serviceWorker.controller);
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (hadController) document.getElementById('update').hidden = false;
            hadController = true;
          });
          document.getElementById('update-reload').addEventListener('click', () => location.reload());
          navigator.serviceWorker
            .register(`${base}sw.js`, { scope: base })
            .then((reg) => {
              // Een app op het beginscherm wordt vaak hervat in plaats van opnieuw geladen:
              // kijk dan ook of er een nieuwe versie is.
              document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') reg.update().catch(() => {});
              });
            })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #f7f6f2;
    --surface: #ffffff;
    --text: #1d1d1b;
    --muted: #6b6a64;
    --line: #e2e0d8;
    --accent: #2f7d4f;
    --accent-text: #ffffff;
    --done: #a3a29b;
    --radius: 14px;
    --tap: 52px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141513;
      --surface: #1f201d;
      --text: #f0efe9;
      --muted: #a3a29b;
      --line: #33342f;
      --accent: #5cbf85;
      --accent-text: #0d1a12;
      --done: #6b6a64;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 18px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    padding-bottom: env(safe-area-inset-bottom);
  }
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  a {
    color: var(--accent);
  }
  .update {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    max-width: calc(40rem - 32px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
    font-size: 0.95rem;
  }
  .update[hidden] {
    display: none;
  }
  .update button {
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-weight: 600;
    color: var(--accent-text);
    background: var(--accent);
    border: 0;
    border-radius: 999px;
  }
  /* Gedeeld door de receptpagina en de boodschappenlijst. */
  .back {
    padding: calc(8px + env(safe-area-inset-top)) 0 0;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-weight: 600;
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 8px 0 10px;
  }
  .section-head h2 {
    font-size: 1.2rem;
    margin: 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    font: inherit;
    font-size: 0.95rem;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
  }
  .pill[hidden] {
    display: none;
  }
  .pill[aria-pressed='true'] {
    color: var(--accent-text);
    background: var(--accent);
    border-color: var(--accent);
  }
  .ingredients {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .ingredients li + li {
    border-top: 1px solid var(--line);
  }
  .ingredients + .afdeling {
    margin-top: 18px;
  }
  .afdeling {
    margin: 0 0 6px 4px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ingredients label {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: var(--tap);
    padding: 10px 16px;
    font-size: 1.1rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .ingredients input {
    flex: none;
    width: 26px;
    height: 26px;
    margin: 0;
    accent-color: var(--accent);
  }
  .ingredients input:checked + span {
    color: var(--done);
    text-decoration: line-through;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
