---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Welke recepten op de lijst staan, weet alleen het toestel; de pagina krijgt daarom de ingrediënten
// van alle recepten mee en stelt de lijst in de browser samen.
const recipes = (await getCollection('recipes')).map((r) => ({
  id: r.id,
  titel: r.data.titel,
  porties: r.data.porties,
  ingredienten: r.data.ingredienten,
}));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Boodschappenlijst · Recepten">
  <main class="narrow">
    <nav class="back">
      <a href={base}>‹ Alle recepten</a>
      <div data-theme-settings></div>
    </nav>
    <h1>Boodschappenlijst</h1>

    <form class="add" id="eigen">
      <label class="sr-only" for="eigen-tekst">Zelf iets toevoegen</label>
      <input
        id="eigen-tekst"
        type="text"
        placeholder="Zelf iets toevoegen, zoals wc-papier"
        enterkeyhint="enter"
        autocomplete="off"
      />
      <button type="submit" class="pill">Toevoegen</button>
    </form>

    <div id="vol" hidden>
      <ul class="chips" id="recepten" aria-label="Recepten op de lijst"></ul>

      <section aria-labelledby="ingr">
        <div class="section-head">
          <h2 id="ingr">Ingrediënten</h2>
          <button type="button" class="pill" id="reset" hidden>Alles weer aan</button>
        </div>
        <div id="ingredienten"></div>
      </section>

      <p class="clear">
        <button type="button" class="pill" id="leegmaken">Lijst leegmaken</button>
      </p>
    </div>

    <p class="empty" id="leeg" hidden>
      Je lijst is leeg. Open een recept en tik op <strong>Op de boodschappenlijst</strong>.
    </p>
    <script id="data" type="application/json" set:html={JSON.stringify(recipes)} />
  </main>
</Base>

<script>
  import { formatIngredient } from '../lib/format';
  import { groupByAfdeling } from '../lib/afdeling';
  import {
    addEigen,
    clearEigen,
    loadEigen,
    loadList,
    loadPorties,
    mergeIngredients,
    removeEigen,
    saveList,
    type Merged,
    type Recipe,
  } from '../lib/lijst';

  // Een eigen item loopt mee als gewone regel, zonder afdeling: het komt dus onder "Overig".
  type Regel = Merged & { eigen?: boolean };

  const all: (Recipe & { porties?: number })[] = JSON.parse(document.getElementById('data')!.textContent ?? '[]');
  const byId = new Map(all.map((r) => [r.id, r]));
  const base = document.querySelector<HTMLAnchorElement>('.back a')!.getAttribute('href')!;

  const vol = document.getElementById('vol')!;
  const leeg = document.getElementById('leeg')!;
  const chips = document.getElementById('recepten')!;
  const list = document.getElementById('ingredienten')!;
  const reset = document.getElementById('reset')!;
  const KEY = 'afgevinkt:lijst';

  function loadChecked(): Set<string> {
    try {
      return new Set(JSON.parse(localStorage.getItem(KEY) ?? '[]'));
    } catch {
      return new Set();
    }
  }
  function saveChecked() {
    const checked = Array.from(list.querySelectorAll<HTMLInputElement>('input:checked'), (b) => b.value);
    try {
      if (checked.length) localStorage.setItem(KEY, JSON.stringify(checked));
      else localStorage.removeItem(KEY);
    } catch {
      /* geen opslag beschikbaar: afvinken werkt dan alleen tot de pagina sluit */
    }
    reset.hidden = checked.length === 0;
  }

  function render() {
    // Een recept dat niet meer bestaat, valt stilletjes van de lijst.
    const ids = loadList().filter((id) => byId.has(id));
    // Elk recept telt mee voor het aantal porties dat op zijn receptpagina is gekozen.
    const recipes = ids.map((id) => {
      const r = byId.get(id)!;
      const gekozen = r.porties ? (loadPorties(id) ?? r.porties) : undefined;
      return { ...r, gekozen, factor: r.porties && gekozen ? gekozen / r.porties : 1 };
    });
    const eigen: Regel[] = loadEigen().map((e) => ({ naam: e.naam, key: e.key, recepten: [], eigen: true }));
    const iets = recipes.length > 0 || eigen.length > 0;
    vol.hidden = !iets;
    leeg.hidden = iets;
    chips.hidden = recipes.length === 0;

    chips.replaceChildren(
      ...recipes.map((r) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `${base}recept/${r.id}/`;
        a.textContent = r.titel;
        if (r.gekozen) {
          const p = document.createElement('small');
          p.textContent = ` · ${r.gekozen} ${r.gekozen === 1 ? 'portie' : 'porties'}`;
          a.append(p);
        }
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'remove';
        x.textContent = '×';
        x.setAttribute('aria-label', `${r.titel} van de lijst halen`);
        x.addEventListener('click', () => {
          saveList(loadList().filter((id) => id !== r.id));
          render();
        });
        li.append(a, x);
        return li;
      }),
    );

    const checked = loadChecked();
    const many = recipes.length > 1;
    const row = (i: Regel) => {
      const li = document.createElement('li');
      const label = document.createElement('label');
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.value = i.key;
      box.checked = checked.has(i.key);
      box.addEventListener('change', saveChecked);
      const text = document.createElement('span');
      text.textContent = i.eigen ? i.naam : formatIngredient(i);
      if (many && !i.eigen) {
        const from = document.createElement('small');
        from.textContent = i.recepten.join(', ');
        text.append(from);
      }
      label.append(box, text);
      li.append(label);
      if (i.eigen) {
        li.className = 'eigen';
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'remove';
        x.textContent = '×';
        x.setAttribute('aria-label', `${i.naam} van de lijst halen`);
        x.addEventListener('click', () => {
          removeEigen(i.key);
          render();
        });
        li.append(x);
      }
      return li;
    };
    list.replaceChildren(
      ...groupByAfdeling<Regel>([...mergeIngredients(recipes), ...eigen]).flatMap((g) => {
        const ul = document.createElement('ul');
        ul.className = 'ingredients';
        ul.append(...g.items.map(row));
        if (!g.titel) return [ul];
        const h = document.createElement('h3');
        h.className = 'afdeling';
        h.textContent = g.titel;
        return [h, ul];
      }),
    );
    saveChecked();
  }

  reset.addEventListener('click', () => {
    for (const b of list.querySelectorAll<HTMLInputElement>('input')) b.checked = false;
    saveChecked();
  });
  document.getElementById('leegmaken')!.addEventListener('click', () => {
    saveList([]);
    clearEigen();
    render();
  });
  const veld = document.getElementById('eigen-tekst') as HTMLInputElement;
  document.getElementById('eigen')!.addEventListener('submit', (e) => {
    e.preventDefault();
    // Leeg of alleen spaties voegt niets toe; het veld blijft open voor het volgende item.
    if (addEigen(veld.value)) render();
    veld.value = '';
    veld.focus();
  });
  // Terug met de terugknop na het aanpassen van porties: de pagina komt dan uit de cache van de browser.
  window.addEventListener('pageshow', (e) => e.persisted && render());
  render();
</script>

<style>
  h1 {
    margin: var(--spacing-1) 0 var(--spacing-3);
  }
  .chips {
    list-style: none;
    margin: 0 0 var(--spacing-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }
  .chips[hidden] {
    display: none;
  }
  .chips :global(small) {
    color: var(--primary-muted);
    font-weight: var(--font-weight-regular);
    font-size: var(--text-sm);
  }
  .chips :global(li) {
    display: inline-flex;
    align-items: center;
    background: var(--bg-2);
    border: 1px solid var(--bg-3);
    border-radius: 999px;
    padding-left: var(--spacing-3-5);
  }
  .chips :global(a) {
    color: var(--fg-1);
    text-decoration: none;
    font-weight: var(--font-weight-bold);
  }
  .chips :global(.remove) {
    min-width: var(--tap);
    min-height: var(--tap);
    font: inherit;
    font-size: var(--text-h3);
    line-height: 1;
    color: var(--primary-muted);
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }
  .chips :global(.remove:focus-visible) {
    outline: 2px solid var(--primary-muted);
    outline-offset: 2px;
  }
  .add {
    display: flex;
    gap: var(--spacing-2);
    margin: 0 0 var(--spacing-4);
  }
  .add input {
    flex: 1;
    min-width: 0;
    min-height: var(--recept-tap);
    font: inherit;
    font-size: var(--text-recept-input);
    padding: 0 var(--spacing-4);
    border: 1px solid var(--bg-3);
    border-radius: var(--recept-radius);
    background: var(--bg-2);
    color: var(--fg-1);
  }
  .add input:focus {
    outline: 2px solid var(--primary-muted);
    outline-offset: 1px;
  }
  .add .pill {
    min-height: var(--recept-tap);
  }
  /* Een eigen item: dezelfde vinkregel, met rechts een kruisje om hem weg te halen. */
  #ingredienten :global(li.eigen) {
    display: flex;
    align-items: center;
  }
  #ingredienten :global(li.eigen label) {
    flex: 1;
    min-width: 0;
  }
  #ingredienten :global(li.eigen .remove) {
    flex: none;
    min-width: var(--tap);
    min-height: var(--tap);
    margin-right: var(--spacing-1);
    font: inherit;
    font-size: var(--text-h3);
    line-height: 1;
    color: var(--primary-muted);
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }
  #ingredienten :global(li.eigen .remove:focus-visible) {
    outline: 2px solid var(--primary-muted);
    outline-offset: 2px;
  }
  #ingredienten :global(small) {
    display: block;
    color: var(--primary-muted);
    font-size: var(--text-sm);
  }
  .clear {
    margin: var(--spacing-5) 0 0;
    text-align: center;
  }
  .empty {
    color: var(--primary-muted);
    text-align: center;
    padding: var(--spacing-6) 0;
  }
</style>
