---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { searchKey } from '../lib/format';

const recipes = (await getCollection('recipes')).sort((a, b) =>
  a.data.titel.localeCompare(b.data.titel, 'nl'),
);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Alle tags die in de recepten voorkomen, op alfabet: dat zijn de filters boven de lijst.
const tags = [...new Set(recipes.flatMap((r) => r.data.tags))].sort((a, b) => a.localeCompare(b, 'nl'));
---

<Base title="Recepten">
  <header class="top">
    <div class="head">
      <h1>Recepten</h1>
      <a class="pill" href={`${base}lijst/`} id="lijst-link">Boodschappenlijst</a>
    </div>
    <label class="search">
      <span class="sr-only">Zoek een recept</span>
      <input
        id="zoek"
        type="search"
        placeholder="Zoek op recept, tag of ingrediënt"
        autocomplete="off"
        enterkeyhint="search"
      />
    </label>
    {
      tags.length > 0 && (
        <div class="tags" role="group" aria-label="Filter op tag">
          {tags.map((t) => (
            <button type="button" class="tag" aria-pressed="false" value={t}>
              {t}
            </button>
          ))}
        </div>
      )
    }
  </header>
  <main>
    <ul class="list" id="lijst">
      {
        recipes.map((r) => (
          <li
            data-zoek={searchKey(r.data.titel, ...r.data.tags, ...r.data.ingredienten.map((i) => i.naam))}
            data-tags={JSON.stringify(r.data.tags)}
          >
            <a href={`${base}recept/${r.id}/`}>
              <span class="title">{r.data.titel}</span>
              <span class="meta">
                {[
                  r.data.tijd && `${r.data.tijd} min`,
                  `${r.data.ingredienten.length} ${r.data.ingredienten.length === 1 ? 'ingrediënt' : 'ingrediënten'}`,
                  ...r.data.tags,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty" id="leeg" hidden>Geen recept gevonden.</p>
  </main>
</Base>

<script>
  const input = document.getElementById('zoek') as HTMLInputElement;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#lijst > li'));
  const empty = document.getElementById('leeg')!;
  const norm = (s: string) =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  // Een aangetikte tag filtert de lijst; met meer tags aan moet een recept ze allemaal hebben.
  const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag'));
  const recipeTags = new Map(items.map((li) => [li, JSON.parse(li.dataset.tags ?? '[]') as string[]]));

  function filter() {
    const words = norm(input.value).split(/\s+/).filter(Boolean);
    const active = tagButtons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.value);
    let shown = 0;
    for (const li of items) {
      const hay = li.dataset.zoek ?? '';
      const own = recipeTags.get(li)!;
      const match = words.every((w) => hay.includes(w)) && active.every((t) => own.includes(t));
      li.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
  }
  for (const b of tagButtons) {
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      filter();
    });
  }
  input.addEventListener('input', filter);
  filter();
</script>

<script>
  import { loadList } from '../lib/lijst';

  // Het aantal recepten op de boodschappenlijst, ook na terugkeren met de terugknop.
  const link = document.getElementById('lijst-link')!;
  function count() {
    const n = loadList().length;
    link.textContent = n ? `Boodschappenlijst · ${n}` : 'Boodschappenlijst';
  }
  window.addEventListener('pageshow', count);
  count();
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--bg);
    padding: calc(12px + env(safe-area-inset-top)) 16px 12px;
    max-width: 40rem;
    margin: 0 auto;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 10px;
  }
  h1 {
    font-size: 1.6rem;
    margin: 0;
  }
  .search input {
    width: 100%;
    min-height: var(--tap);
    font: inherit;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
  }
  .search input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  /* Eén rij die horizontaal scrolt, zodat de lijst bij veel tags niet naar beneden schuift. */
  .tags {
    display: flex;
    gap: 8px;
    margin: 10px -16px 0;
    padding: 0 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tags::-webkit-scrollbar {
    display: none;
  }
  .tag {
    flex: none;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .tag[aria-pressed='true'] {
    color: var(--accent-text);
    background: var(--accent);
    border-color: var(--accent);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .list a {
    display: block;
    min-height: var(--tap);
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }
  .list a:active {
    background: var(--line);
  }
  .title {
    display: block;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .meta {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .empty {
    color: var(--muted);
    text-align: center;
    padding: 24px 0;
  }
</style>
