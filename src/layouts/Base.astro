---
// De huisstijl van DKJ-Solutions eerst, ongewijzigd uit dkj-brandbook (tag house-style-v3); de eigen
// laag van deze app erna. Zie src/styles/.
import '../styles/house-style.css';
import '../styles/recepten.css';
import houseTheme from '../styles/house-theme.js?raw';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="nl" data-theme-default="rust">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Recepten van Dave, snel bij de hand in de supermarkt." />
    <meta name="theme-color" content="#4c5e61" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Recepten" />
    <!-- In de head, zodat het gekozen thema er staat voordat er iets getekend wordt. -->
    <script is:inline set:html={houseTheme} />
  </head>
  <body>
    <slot />
    <div class="update" id="update" role="status" hidden>
      <span>Nieuwe versie beschikbaar</span>
      <button type="button" id="update-reload">Verversen</button>
    </div>
    <script is:inline>
      // Elke pagina zet een [data-theme-settings] neer waar de instellingenknop moet komen.
      for (const el of document.querySelectorAll('[data-theme-settings]')) DKJTheme.settings(el);
    </script>
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          // De eerste controller is de eerste installatie: niets nieuws te melden. Elke wissel daarna is
          // een nieuwe versie.
          let hadController = Boolean(navigator.serviceWorker.controller);
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (hadController) document.getElementById('update').hidden = false;
            hadController = true;
          });
          document.getElementById('update-reload').addEventListener('click', () => location.reload());
          navigator.serviceWorker
            .register(`${base}sw.js`, { scope: base })
            .then((reg) => {
              // Een app op het beginscherm wordt vaak hervat in plaats van opnieuw geladen:
              // kijk dan ook of er een nieuwe versie is.
              document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') reg.update().catch(() => {});
              });
            })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
