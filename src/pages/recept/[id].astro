---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { groupByAfdeling } from '../../lib/afdeling';
import { formatIngredient } from '../../lib/format';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { titel, porties, tijd, tags, bron, ingredienten } = recipe.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const meta = [porties && `${porties} porties`, tijd && `${tijd} min`, ...tags].filter(Boolean);
---

<Base title={`${titel} · Recepten`}>
  <main>
    <nav class="back">
      <a href={base}>‹ Alle recepten</a>
    </nav>
    <h1>{titel}</h1>
    {meta.length > 0 && <p class="meta">{meta.join(' · ')}</p>}
    <div class="actions">
      <button type="button" class="pill" id="op-lijst" aria-pressed="false">
        Op de boodschappenlijst
      </button>
      <a class="pill" id="naar-lijst" href={`${base}lijst/`} hidden>Naar de lijst ›</a>
    </div>

    <section aria-labelledby="ingr">
      <div class="section-head">
        <h2 id="ingr">Ingrediënten</h2>
        <button type="button" class="pill" id="reset" hidden>Alles weer aan</button>
      </div>
      <div id="ingredienten" data-recept={recipe.id}>
        {
          groupByAfdeling(ingredienten.map((i, n) => ({ ...i, n }))).map((g) => (
            <>
              {g.titel && <h3 class="afdeling">{g.titel}</h3>}
              <ul class="ingredients">
                {g.items.map((i) => (
                  <li>
                    <label>
                      <input type="checkbox" value={i.n} />
                      <span>{formatIngredient(i)}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="bereiding" class="steps">
      <h2 id="bereiding">Bereiding</h2>
      <Content />
      {
        bron && (
          <p class="bron">
            Bron: {/^https?:\/\//.test(bron) ? <a href={bron} rel="noopener">{bron}</a> : bron}
          </p>
        )
      }
    </section>
  </main>
</Base>

<script>
  import { loadList, saveList } from '../../lib/lijst';

  // Afgevinkte ingrediënten worden per recept op dit toestel onthouden.
  const list = document.getElementById('ingredienten')!;
  const reset = document.getElementById('reset')!;
  const id = list.dataset.recept!;
  const key = `afgevinkt:${id}`;
  const boxes = Array.from(list.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));

  function load(): string[] {
    try {
      return JSON.parse(localStorage.getItem(key) ?? '[]');
    } catch {
      return [];
    }
  }
  function save() {
    const checked = boxes.filter((b) => b.checked).map((b) => b.value);
    try {
      if (checked.length) localStorage.setItem(key, JSON.stringify(checked));
      else localStorage.removeItem(key);
    } catch {
      /* geen opslag beschikbaar: afvinken werkt dan alleen tot de pagina sluit */
    }
    reset.hidden = checked.length === 0;
  }

  const saved = new Set(load());
  for (const b of boxes) {
    b.checked = saved.has(b.value);
    b.addEventListener('change', save);
  }
  reset.addEventListener('click', () => {
    for (const b of boxes) b.checked = false;
    save();
  });
  reset.hidden = saved.size === 0;

  // Het recept op de boodschappenlijst zetten of eraf halen.
  const toggle = document.getElementById('op-lijst')!;
  const toList = document.getElementById('naar-lijst')!;
  function show(on: boolean) {
    toggle.setAttribute('aria-pressed', String(on));
    toggle.textContent = on ? '✓ Op de boodschappenlijst' : 'Op de boodschappenlijst';
    toList.hidden = !on;
  }
  toggle.addEventListener('click', () => {
    const ids = loadList().filter((x) => x !== id);
    const on = toggle.getAttribute('aria-pressed') !== 'true';
    saveList(on ? [...ids, id] : ids);
    show(on);
  });
  show(loadList().includes(id));
</script>

<style>
  h1 {
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 4px 0 4px;
  }
  .meta {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
  }
  h2 {
    font-size: 1.2rem;
    margin: 0;
  }
  .steps {
    margin-top: 28px;
  }
  .steps :global(ol),
  .steps :global(ul) {
    padding-left: 1.4em;
  }
  .steps :global(li) {
    margin-bottom: 0.6em;
  }
  .bron {
    color: var(--muted);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
</style>
