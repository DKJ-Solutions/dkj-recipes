---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Recepten van Dave, snel bij de hand in de supermarkt." />
    <meta name="theme-color" content="#2f7d4f" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icons/icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Recepten" />
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #f7f6f2;
    --surface: #ffffff;
    --text: #1d1d1b;
    --muted: #6b6a64;
    --line: #e2e0d8;
    --accent: #2f7d4f;
    --accent-text: #ffffff;
    --done: #a3a29b;
    --radius: 14px;
    --tap: 52px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141513;
      --surface: #1f201d;
      --text: #f0efe9;
      --muted: #a3a29b;
      --line: #33342f;
      --accent: #5cbf85;
      --accent-text: #0d1a12;
      --done: #6b6a64;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 18px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    padding-bottom: env(safe-area-inset-bottom);
  }
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  a {
    color: var(--accent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
